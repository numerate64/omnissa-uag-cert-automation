{
  "HorizonFqdn": "horizon.example.com",
  "LetsEncryptEmail": "admin@example.com",
  "WinAcmePath": "C:\\Tools\\win-acme\\wacs.exe",
  "UseExistingWinAcmeRenewal": true,
  "WinAcmeRenewalId": "REPLACE_WITH_WIN_ACME_RENEWAL_ID",
  "WinAcmeBaseUri": "https://acme-v02.api.letsencrypt.org/",

  "AwsAccessKeyId": "",
  "AwsSecretAccessKey": "",

  "UagHosts": [
    "uag-admin.example.local"
  ],
  "UagUsername": "admin",
  "UagPassword": "REDACTED",
  "UagPasswordProtected": "",
  "UagAuthMode": "Basic",
  "UagVerifyTls": false,
  "UagUploadMode": "Pem",
  "UagCertificateTargets": [
    "END_USER"
  ],

  "PemDirectory": "C:\\CertAutomation\\certs",
  "FullChainPemPath": "C:\\CertAutomation\\certs\\horizon.example.com-chain.pem",
  "PrivateKeyPemPath": "C:\\CertAutomation\\certs\\horizon.example.com-key.pem",

  "PfxPath": "C:\\CertAutomation\\certs\\horizon.example.com.pfx",
  "PfxPassword": "",
  "PfxPasswordProtected": "REDACTED_DPAPI_VALUE",
  "UagPfxEndpointTemplate": "https://{0}:9443/rest/v1/config/certificates/server",

  "WacsBaseArguments": [
    "--target", "manual",
    "--host", "horizon.example.com",
    "--validation", "route53",
    "--source", "manual",
    "--installation", "none",
    "--accepttos",
    "--emailaddress", "admin@example.com"
  ],
  "WacsAdditionalArguments": [
    "--verbose"
  ]
}
